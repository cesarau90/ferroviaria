# Local development normally needs no variables: Vite proxies /api to localhost:3001.
# Production backend (Railway with a persistent volume)
DATABASE_PATH=/data/railguard.db
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://your-project.vercel.app

# Vercel build variables. These must be set in Vercel before deploying the frontend.
VITE_API_URL=https://your-railguard-api.up.railway.app/api
VITE_SOCKET_URL=https://your-railguard-api.up.railway.app
